# Shared by every app. Copy to .env and adjust.
NODE_ENV=development
LOG_LEVEL=info

# Host ports Docker Compose publishes Postgres/Redis on.
# Change them if you already run Postgres/Redis natively.
POSTGRES_PORT=5432
REDIS_PORT=6379

DATABASE_URL=postgresql://terraplan:terraplan@localhost:5432/terraplan?schema=public
REDIS_URL=redis://localhost:6379

# apps/web (Next.js)
WEB_PORT=3005
# Where the web server proxies /api/v1/* to.
API_INTERNAL_URL=http://localhost:4000
# Browser-reachable API (WebSocket for live locks). Same as API_PUBLIC_URL for local dev.
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3005

# apps/api (NestJS)
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3005

# Session JWT (min 32 chars). Change this in every real deployment.
SESSION_SECRET=dev-only-change-me-terraplan-session-secret
SESSION_TTL_HOURS=168

# Google SSO (required for sign-in).
# Authorized redirect URI: {WEB_PUBLIC_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Leave empty so the first Google sign-in becomes Admin automatically.
# Set only if you want a pre-created admin email (optional).
AUTH_BOOTSTRAP_ADMIN_EMAIL=
# Later Google users join automatically as Viewer (no invite). Set false to require invites.
AUTH_ALLOW_AUTO_JOIN=true

# Encrypts Bitbucket workspace API credentials at rest. Defaults to SESSION_SECRET if unset.
CREDENTIALS_ENCRYPTION_KEY=

# apps/runner (BullMQ worker)
# simulate: fake plan/apply output, no cloud credentials needed.
# terraform: clones the repo into an isolated temp dir, pins terraform per
# environment, runs init → validate → plan -out → show -json → apply/destroy.
RUNNER_MODE=simulate
RUNNER_CONCURRENCY=2
RUNNER_HEALTH_PORT=4100
TERRAFORM_BIN=terraform
TERRAFORM_VERSIONS_DIR=./.terraform-versions
TERRAFORM_WORKSPACES_DIR=./.runner-workspaces

# Durable plan binaries, plan JSON, and run logs.
# When ARTIFACTS_S3_BUCKET is unset, files are written under ARTIFACTS_LOCAL_DIR.
ARTIFACTS_S3_BUCKET=
ARTIFACTS_S3_REGION=us-east-1
ARTIFACTS_S3_PREFIX=terraplan/
ARTIFACTS_LOCAL_DIR=./.runner-artifacts

# ── Platform guardrails ──────────────────────────────────────────
# Max runs a single user may create per rolling hour (API → 429).
RATE_LIMIT_RUNS_PER_HOUR=30
# Max waiting_approval + queued + running runs per user (API → 409).
USER_MAX_CONCURRENT_RUNS=3
# Soft wall-clock timeout for a single run (runner kills terraform).
RUN_TIMEOUT_SECONDS=3600
# Extra comma-separated Terraform flags to deny (merged with built-in list).
TF_DENIED_FLAGS=
# Fail the run when high-severity secrets appear in plan JSON / logs.
SECRET_SCAN_FAIL_ON_HIGH=true

# ── Notifications (Slack Incoming Webhook / Teams Connector) ─────
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
# Comma-separated: waiting_approval,queued,running,succeeded,failed,cancelled
NOTIFY_ON=waiting_approval,failed,succeeded

# Prometheus text metrics at GET /api/v1/metrics (protect at ingress).
METRICS_ENABLED=true
